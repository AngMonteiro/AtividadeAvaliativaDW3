{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Veículos</h1>
    <p class="text-secondary mb-0">Consulte os veículos cadastrados no sistema.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Lista de veículos</h2>
          <p class="text-secondary mb-0">Use <strong>Saída</strong> quando o carro for embora. <strong>Excluir</strong> é só para cadastros feitos por engano.</p>
        </div>
        <a class="btn btn-primary" href="/veiculos/form?oper=Cr" id="btnNovoVeiculo"><i class="bi bi-plus-lg me-1"></i>Incluir novo veículo</a>
      </div>

      <div id="veiculosAlert" class="alert alert-danger d-none" role="alert"></div>

      <div id="veiculosListagem" data-servidor-api="{{ servidorApi }}">
        <div class="table-responsive">
          <table id="tblVeiculos" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Placa</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Dono</th>
                <th>Situação</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/estfrontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/apps/veiculos/vwLstVeiculos.js"></script>
{% endblock %}
